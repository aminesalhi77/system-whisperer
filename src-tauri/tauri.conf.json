{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "system-whisperer",
  "version": "0.1.0",
  "identifier": "com.cheester.systemwhisperer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/icons/**",
          "/usr/share/pixmaps/**",
          "/usr/local/share/**",
          "/var/lib/flatpak/**",
          "/home/cheester/.local/share/**"
        ]
      }
    },
    "windows": [
      {
        "title": "System Whisperer",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}